{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHUD",
  "version": "2.0.6",
  "identifier": "com.chacca.agenthud",
  "mainBinaryName": "AgentHUD",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["wallpapers/*", "native/island_glass/LICENSE.electron-liquid-glass"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/codez-yydd/AgentHUD/releases/latest/download/latest.json",
        "https://gitee.com/codezwx/AgentHUD/releases/download/latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCNzBGQjcxNzRFNTNGOTYKUldTV1ArVjBjZnR3TzBaUlY2K1RJNjdpOGpwOElualJobnQ3bWlUelZUbS9VSGtNd3dYeDJtWWsK"
    }
  }
}
